---
import content from '../../data/content.json';

const { title, paragraphs, image } = content.zonnebloemCompetitie;
---

<section id="zonnebloemCompetitie" class="section">
  <div class="container grid-layout">

    <div class="image-wrap animate-on-scroll">
      <div class="img-frame">
        <img
          src={image.src}
          alt={image.alt}
          loading="lazy"
        />
      </div>
    </div>

    <div class="content animate-on-scroll-right">
      <div class="icon-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14.6 8L16.6 8M13.84 6.16L15.25 4.75M12 5.4L12 3.4M10.16 6.16L8.75 4.75M9.4 8L7.4 8M10.16 9.84L8.75 11.25M12 10.6L12 12.6M13.84 9.84L15.25 11.25"></path>
          <circle cx="12" cy="8" r="2"></circle>
          <path d="M12 12.6V22"></path>
          <path d="M12 22c4.2 0 7-1.667 7-5-4.2 0-7 1.667-7 5Z"></path>
          <path d="M12 22c-4.2 0-7-1.667-7-5 4.2 0 7 1.667 7 5Z"></path>
        </svg>
      </div>
      <h2>{title}</h2>
      {paragraphs.map((p) => <p set:html={p} />)}
    </div>

  </div>
</section>

<style>
  .section {
    background-color: var(--clr-bg);
    padding-block: var(--space-section);
  }

  .grid-layout {
    align-items: center;
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 1024px) {
    .grid-layout {
      gap: 4rem;
      grid-template-columns: 1fr 1fr;
    }

    .image-wrap {
      order: 1;
    }

    .content {
      order: 2;
    }
  }

  .image-wrap {
    order: 1;
  }

  .content {
    order: 2;
  }

  .img-frame {
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
  }

  .img-frame img {
    height: 600px;
    object-fit: cover;
    width: 100%;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .icon-wrap {
    align-items: center;
    background: color-mix(in srgb, var(--clr-primary) 15%, transparent);
    border-radius: var(--radius-lg);
    color: var(--clr-primary);
    display: inline-flex;
    height: 4rem;
    justify-content: center;
    width: 4rem;
  }

  h2 {
    color: var(--clr-fg);
  }

  p {
    color: var(--clr-muted-fg);
    font-size: var(--fs-lg);
  }
</style>
